{
  "name": "mini-commerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build",
    "prebuild": "node scripts/configure-api.mjs",
    "prestart": "node scripts/configure-api.mjs",
    "format": "prettier --write src/main.ts src/index.html src/styles.css scripts *.json",
    "format:check": "prettier --check src/main.ts src/index.html src/styles.css scripts *.json",
    "test:config": "node --test scripts/configure-api.test.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "typescript": "~5.9.3",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": "24.x"
  }
}
